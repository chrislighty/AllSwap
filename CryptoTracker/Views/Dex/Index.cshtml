@model CryptoTracker.Models.TokenSwap

<h1>DEX Swap Simulator</h1>

<form method="post">
    <div class="mb-3">
        <label>Token In</label>
        <input asp-for="TokenIn" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Token Out</label>
        <input asp-for="TokenOut" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Amount</label>
        <input asp-for="AmountIn" type="number" step="0.0001" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Estimate Swap</button>
</form>

@if (Model.EstimatedAmountOut > 0)
{
    <p class="mt-3">
        Estimated Output: <strong>@Model.EstimatedAmountOut</strong> @Model.TokenOut
    </p>
    <button class="btn btn-success" onclick="swapTokens('@Model.TokenIn', '@Model.TokenOut', @Model.AmountIn)">Execute Swap</button>
}

<hr />

<button class="btn btn-secondary" onclick="connectWallet()">Connect MetaMask</button>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/web3/dist/web3.min.js"></script>
    <script>
        async function connectWallet() {
            if (window.ethereum) {
                try {
                    await window.ethereum.request({ method: 'eth_requestAccounts' });
                    window.web3 = new Web3(window.ethereum);
                    alert('Wallet connected!');
                } catch (error) {
                    alert('User denied account access');
                }
            } else {
                alert('Install MetaMask first');
            }
        }

        async function swapTokens(tokenIn, tokenOut, amountIn) {
            if (!window.web3) {
                alert('Please connect your wallet first.');
                return;
            }

            const accounts = await web3.eth.getAccounts();
            if (accounts.length === 0) {
                alert('No accounts found. Make sure MetaMask is unlocked.');
                return;
            }

            const routerAddress = '0x7a250d5630B4cF539739dF2C5dAcb4c659F2488D'; // Uniswap V2 Router
            const routerAbi = [{"constant":false,"inputs":[{"name":"amountIn","type":"uint256"},{"name":"amountOutMin","type":"uint256"},{"name":"path","type":"address[]"},{"name":"to","type":"address"},{"name":"deadline","type":"uint256"}],"name":"swapExactTokensForTokens","outputs":[{"name":"amounts","type":"uint256[]"}],"payable":false,"stateMutability":"nonpayable","type":"function"}];

            const contract = new web3.eth.Contract(routerAbi, routerAddress);
            const amountInWei = web3.utils.toWei(amountIn.toString(), 'ether');
            const path = [tokenIn, tokenOut];
            const to = accounts[0];
            const deadline = Math.floor(Date.now() / 1000) + 60 * 10; // 10 minutes from now

            try {
                // ERC20 Approval Step
                const erc20Abi = [{"constant":false,"inputs":[{"name":"_spender","type":"address"},{"name":"_value","type":"uint256"}],"name":"approve","outputs":[{"name":"","type":"bool"}],"payable":false,"stateMutability":"nonpayable","type":"function"}];
                const tokenContract = new web3.eth.Contract(erc20Abi, tokenIn);

                console.log(`Approving ${amountIn} of ${tokenIn} for the Uniswap router...`);
                await tokenContract.methods.approve(routerAddress, amountInWei).send({ from: accounts[0] });
                console.log('Approval successful.');

                // Swap Step
                console.log('Executing swap...');
                const receipt = await contract.methods.swapExactTokensForTokens(
                    amountInWei,
                    0, // NOTE: For a real application, you should calculate a proper amountOutMin to protect against slippage.
                    path,
                    to,
                    deadline
                ).send({ from: accounts[0] });

                alert('Swap successful!');

                // After the swap is successful, record it in the portfolio
                await recordSwapInPortfolio(tokenIn, tokenOut, amountIn, receipt);

            } catch (error) {
                console.error('Swap failed:', error);
                alert('Swap failed. See console for details.');
            }
        }

        async function recordSwapInPortfolio(tokenIn, tokenOut, amountIn, receipt) {
            // Parse the transaction receipt to find the actual amount of tokens received.
            const swapEventTopic = '0xd78ad95fa46c994b6551d0da85fc275fe613ce37657fb8d5e3d130840159d822'; // Sync event signature for Uniswap V2
            const swapEvent = receipt.events.find(e => e.raw.topics[0] === swapEventTopic);

            let amountOut = 0;
            if (swapEvent) {
                // This is a simplified way to determine amountOut. A robust solution
                // would need to check the token addresses involved in the event.
                // For this demo, we assume the last amount in the event is the amountOut.
                const decoded = web3.eth.abi.decodeLog(['uint256', 'uint256'], swapEvent.raw.data, []);
                amountOut = web3.utils.fromWei(decoded[1].toString(), 'ether');
            } else {
                // Fallback to the estimate if the event isn't found (less accurate)
                amountOut = @Model.EstimatedAmountOut;
            }

            const swapData = {
                tokenIn: tokenIn,
                amountIn: amountIn,
                tokenOut: tokenOut,
                amountOut: amountOut
            };

            try {
                const response = await fetch('/Dex/RecordSwap', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(swapData),
                });

                if (response.ok) {
                    console.log('Portfolio updated.');
                    window.location.href = '/Portfolio'; // Redirect to portfolio page
                } else {
                    console.error('Failed to update portfolio:', await response.text());
                }
            } catch (error) {
                console.error('Error updating portfolio:', error);
            }
        }
    </script>
}